# Required: Gemini API key. Keep the real .env file out of Git.
GEMINI_API_KEY=replace-with-a-gemini-api-key

# Change this to any Gemini model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash

# Gemini Live API model for /ws/voice.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Required for /ws/voice and recommended for a public DojoPaaS endpoint.
# The voice gateway fails closed when this is empty.
DEVICE_SHARED_TOKEN=replace-with-a-long-random-token

# Voice gateway limits.
VOICE_MAX_SESSIONS=2
VOICE_MAX_SESSION_SECONDS=600
VOICE_MAX_AUDIO_BYTES=8000000
VOICE_AUTH_TIMEOUT_SECONDS=10

# Optional: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
