# Required: OpenAI API key. Keep the real .env file out of Git.
OPENAI_API_KEY=sk-replace-me

# Change this to any model available to your OpenAI account.
OPENAI_MODEL=gpt-4o-mini

# Recommended for a public DojoPaaS endpoint.
# Leave empty only for local/private testing.
DEVICE_SHARED_TOKEN=replace-with-a-long-random-token

# Optional: DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
